// =============================================================================
// Marketing Decision Intelligence Platform — Canonical Domain Schema
// =============================================================================
// PostgreSQL (Neon) — multi-tenant with application-level TenantContext
// (AsyncLocalStorage) + repository-layer tenant_id enforcement (defense in
// depth). Raw source records retained per Section 10. Lineage is first-class
// via `lineage_id` + `Edge`.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -----------------------------------------------------------------------------
// 0. TENANCY & IDENTITY (operational)
// -----------------------------------------------------------------------------

model Tenant {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  plan          String   @default("standard") // standard | enterprise
  region        String   @default("us-east-1")
  autonomyLevel Int      @default(1) // Section 22: 0..5
  isolationMode String   @default("pooled") // pooled | silo
  learningOptIn Boolean  @default(false) // cross-tenant aggregated priors
  executionMode String   @default("SIMULATION") // SIMULATION | SANDBOX | LIVE (ADR-0005)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  organizations Organization[]
  brands        Brand[]
  users         User[]
  connectors    Connector[]
  campaigns     Campaign[]
  experiments   Experiment[]
  recommendations Recommendation[]
  decisions     Decision[]
  events        Event[]
  rawRecords    RawRecord[]
  customers     Customer[]
  audiences     Audience[]
  creatives     Creative[]
  causalEstimates CausalEstimate[]
  edges         Edge[]
  workflows     Workflow[]
  agentRuns     AgentRun[]
  agentToolCalls AgentToolCall[]
  auditLogs     AuditLog[]
  policies      Policy[]
  approvals     Approval[]
  capitalLedgerEntries CapitalLedgerEntry[]
  growthExperiments GrowthExperiment[]
  prospects     Prospect[]
  outreaches    Outreach[]
  contentAssets ContentAsset[]
  diagnosticRuns DiagnosticRun[]
}

// -----------------------------------------------------------------------------
// 0b. CAPITAL LEDGER — Zero-Capital Growth Engine
// -----------------------------------------------------------------------------
// Tracks available/committed/spent capital + expected/realized returns +
// reinvestment pool. When available capital = $0, the decision engine
// prioritizes zero-capital channels (organic, SEO, tools, outreach,
// referrals, community, PLG). Once revenue exists, it flows back into the
// reinvestment pool.

model CapitalLedgerEntry {
  id                 String   @id @default(cuid())
  tenantId           String
  type               String   // AVAILABLE | COMMITTED | SPENT | EXPECTED_RETURN | REALIZED_RETURN | REINVESTMENT
  amount             Float
  currency           String   @default("USD")
  source             String   // bootstrap | revenue | experiment | grant | ...
  // CAPITAL PROVENANCE — capital has explicit origin so the platform can
  // never fool itself into thinking synthetic/test capital is earned revenue.
  provenance         String   @default("SYNTHETIC") // SYNTHETIC | OWNER_FUNDED | EARNED_REVENUE | REINVESTED_PROFIT
  // VERIFICATION LEVEL (reviewer fix) — only PAYMENT_VERIFIED counts toward
  // "VERIFIED CUSTOMER / VERIFIED REVENUE" in the headline metric.
  // manual_verification → MANUALLY_ASSERTED (does NOT count as verified).
  verificationLevel  String   @default("SIMULATED") // SIMULATED | TEST | MANUALLY_ASSERTED | PAYMENT_VERIFIED
  verifiedAt         DateTime?
  verifiedBy         String?
  // CONTRIBUTION PROFIT CHAIN (reviewer fix) — revenue ≠ profit ≠ available
  // capital. For EARNED_REVENUE entries, these fields record the full chain:
  //   revenue − refunds − paymentFees − costOfDelivery − taxes = contributionProfit
  //   contributionProfit × reinvestmentRate = available marketing capital
  grossRevenue       Float?
  refunds            Float    @default(0)
  paymentFees        Float    @default(0)
  costOfDelivery     Float    @default(0)
  taxes              Float    @default(0)
  contributionProfit Float?
  reinvestmentRate   Float?   // 0..1, conservative default applied by service
  referenceType      String?  // Campaign | Experiment | Decision | GrowthExperiment | ...
  referenceId        String?
  description        String?
  createdAt          DateTime @default(now())
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, type])
  @@index([tenantId, provenance])
  @@index([referenceType, referenceId])
}

// -----------------------------------------------------------------------------
// 0c. GROWTH EXPERIMENT — first-class acquisition experiment (milestone 2)
// -----------------------------------------------------------------------------
// Distinct from marketing Experiment (which tests creative A vs B). A Growth
// Experiment tests "will this acquisition mechanism produce qualified
// customers?" It tracks the full funnel: exposure → visitors → leads →
// qualified leads → signups → activated → customers → revenue.

model GrowthExperiment {
  id                  String   @id @default(cuid())
  tenantId            String
  name                String
  hypothesis          String
  icp                 String?  // Ideal Customer Profile description (JSON)
  problem             String?  // The problem this experiments tests solving
  acquisitionMechanism String  // founder_outreach | teardown | free_tool | content | seo | referral | ...
  distributionChannel String?  // email | linkedin | twitter | organic_search | direct | ...
  intervention        String?  // What we did
  expectedOutcome     String?  // JSON
  cost                Float    @default(0) // cash cost (always $0 in this milestone)
  effortHours         Float    @default(0) // non-cash cost tracking
  status              String   @default("draft") // draft | running | completed | analyzed
  // Funnel metrics
  exposure            Int      @default(0)
  visitors            Int      @default(0)
  leads               Int      @default(0)
  qualifiedLeads      Int      @default(0)
  signups             Int      @default(0)
  activatedUsers      Int      @default(0)
  customers           Int      @default(0)
  revenue             Float    @default(0)
  contributionMargin  Float    @default(0)
  timeToConversionDays Float?
  evidence            String?  // JSON []
  decision            String?  // ship | iterate | kill
  learning            String?
  startDate           DateTime?
  endDate             DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  prospects           Prospect[]
  outreaches          Outreach[]
  contentAssets       ContentAsset[]

  @@index([tenantId])
  @@index([tenantId, acquisitionMechanism])
  @@index([tenantId, status])
}

// -----------------------------------------------------------------------------
// 0d. PROSPECT / ACCOUNT INTELLIGENCE (milestone 5)
// -----------------------------------------------------------------------------

model Prospect {
  id              String   @id @default(cuid())
  tenantId        String
  // Account info (publicly available only)
  company         String
  website         String?
  industry        String?
  size            String?  // startup | small | mid | enterprise
  region          String?
  // Contact (human-approved outreach only)
  contactName     String?
  contactEmail    String?
  contactTitle    String?
  linkedinUrl     String?
  // ICP fit + qualification
  icpFitScore     Float    @default(0) // 0..1
  qualificationSignals String? // JSON []
  opportunitySignals   String? // JSON []
  // Outreach state
  status          String   @default("identified") // identified | researching | diagnosed | contacted | responded | qualified | converted | rejected
  outreachState   String   @default("none") // none | drafting | pending_approval | approved | sent | replied | conversation | closed
  lastContactedAt DateTime?
  // Source + evidence
  source          String   @default("manual") // manual | diagnostic_tool | referral | ...
  evidence        String?  // JSON []
  notes           String?
  growthExperimentId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  growthExperiment GrowthExperiment? @relation(fields: [growthExperimentId], references: [id], onDelete: SetNull)
  outreaches      Outreach[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, outreachState])
}

// -----------------------------------------------------------------------------
// 0e. OUTREACH — founder-led outreach with human approval (milestone 9)
// -----------------------------------------------------------------------------

model Outreach {
  id              String   @id @default(cuid())
  tenantId        String
  prospectId      String
  growthExperimentId String?
  type            String   // email | linkedin | twitter | ...
  subject         String?
  body            String
  diagnosis       String?  // The evidence-backed diagnosis that informs this outreach
  rationale       String?  // Why this prospect was selected
  status          String   @default("draft") // draft | pending_approval | approved | sent | replied | bounced | closed
  approvedBy      String?
  approvedAt      DateTime?
  sentAt          DateTime?
  repliedAt       DateTime?
  responseSummary String?
  outcome         String?  // conversation | qualified | converted | rejected | no_response
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  prospect        Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  growthExperiment GrowthExperiment? @relation(fields: [growthExperimentId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([prospectId])
}

// -----------------------------------------------------------------------------
// 0f. CONTENT ASSET — evidence-based content tied to acquisition hypothesis
// -----------------------------------------------------------------------------

model ContentAsset {
  id              String   @id @default(cuid())
  tenantId        String
  growthExperimentId String?
  type            String   // teardown | benchmark | case_study | research_report | diagnostic | blog | ...
  title           String
  targetICP       String?
  hypothesis      String?
  distributionPlan String? // JSON
  status          String   @default("draft") // draft | published | measured
  url             String?
  body            String?
  exposure        Int      @default(0)
  visitors        Int      @default(0)
  leads           Int      @default(0)
  measuredOutcome String?  // JSON
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  growthExperiment GrowthExperiment? @relation(fields: [growthExperimentId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, type])
  @@index([tenantId, status])
}

// -----------------------------------------------------------------------------
// 0g. DIAGNOSTIC RUN — explicit intent funnel (reviewer fix)
// -----------------------------------------------------------------------------
// A visitor running the diagnostic tool is NOT automatically a Prospect.
// The funnel is:
//   DiagnosticRun (visitor ran the tool)
//     → IdentifiedOrganization (system detected a real company)
//       → PotentialProspect (operator flagged for review)
//         → QualifiedProspect (= Prospect, operator approved for outreach)
//
// This prevents funnel inflation. Promotion requires explicit action.

model DiagnosticRun {
  id              String   @id @default(cuid())
  tenantId        String
  // What the visitor provided
  company         String
  website         String?
  industry        String?
  size            String?
  notes           String?
  // The diagnosis output
  diagnosis       String   // JSON: observed/inferred/predicted/recommended
  provider        String?
  model           String?
  fellBack        Boolean  @default(false)
  // Funnel stage
  stage           String   @default("diagnostic_run") // diagnostic_run | identified_organization | potential_prospect | promoted_to_prospect | rejected
  // Link to Prospect if promoted
  prospectId      String?
  // Meta
  visitorIp       String?
  createdAt       DateTime @default(now())
  promotedAt      DateTime?
  promotedBy      String?
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, stage])
  @@index([prospectId])
}

model Organization {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model User {
  id        String   @id @default(cuid())
  tenantId  String?  // nullable for admin users who span all tenants
  email     String   @unique
  name      String
  password  String?  // hashed (nullable for seed users without login)
  roles     String   @default("marketer") // csv: ceo,cmo,marketer,analyst,admin
  isDemo    Boolean  @default(false) // demo accounts with quick login
  isActive  Boolean  @default(true) // deactivated users cannot log in
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  approvals Approval[]

  @@index([tenantId])
}

model WaitlistEntry {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  password      String   // hashed — used when admin creates the account
  requestedRole String   @default("marketer")
  tenantSlug    String?  // requested tenant, or null for admin to decide
  status        String   @default("pending") // pending | approved | rejected
  reviewedBy    String?
  reviewedAt    DateTime?
  createdUserId String?  // the User id created on approval
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Policy {
  // Section 22 — tenant-configurable autonomy policy
  id              String   @id @default(cuid())
  tenantId        String
  name            String
  maxSpendChangePct Float  @default(10)
  allowedChannels String   @default("google_ads,meta,email")
  allowedActions  String   @default("pause,publish_draft,create_experiment")
  requiresApproval Boolean @default(true)
  riskThreshold   Float    @default(0.3)
  operatingHours  String   @default("00-24")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// -----------------------------------------------------------------------------
// 1. BRAND / PRODUCT / MARKET (operational)
// -----------------------------------------------------------------------------

model Brand {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  category    String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products    Product[]
  campaigns   Campaign[]
  creatives   Creative[]

  @@index([tenantId])
}

model Product {
  id        String   @id @default(cuid())
  tenantId  String
  brandId   String
  name      String
  price     Float
  currency  String   @default("USD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([brandId])
}

// -----------------------------------------------------------------------------
// 2. CUSTOMER / AUDIENCE (operational + analytical)
// -----------------------------------------------------------------------------

model Customer {
  id          String   @id @default(cuid())
  tenantId    String
  externalId  String?
  email       String?
  name        String?
  segment     String?  // new | returning | vip | churned
  ltv         Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  interactions Interaction[]

  @@index([tenantId])
  @@index([tenantId, segment])
}

model Audience {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  size        Int      @default(0)
  criteria    String   // JSON: { segment, ltv_min, ... }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// -----------------------------------------------------------------------------
// 3. CREATIVE (operational)
// -----------------------------------------------------------------------------

model Creative {
  id          String   @id @default(cuid())
  tenantId    String
  brandId     String?
  name        String
  format      String   @default("image") // image | video | text | carousel
  channel     String?
  hook        String?
  promise     String?
  cta         String?
  embedding   String?  // JSON vec (deferred for MVP)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brand       Brand?   @relation(fields: [brandId], references: [id], onDelete: SetNull)
  ads         Ad[]

  @@index([tenantId])
  @@index([tenantId, channel])
}

// -----------------------------------------------------------------------------
// 4. CAMPAIGN / ADSET / AD (operational)
// -----------------------------------------------------------------------------

model Campaign {
  id          String   @id @default(cuid())
  tenantId    String
  brandId     String?
  externalId  String?
  name        String
  channel     String   // google_ads | meta | shopify_email | tiktok | ...
  status      String   @default("draft") // draft | active | paused | completed
  objective   String?  // awareness | consideration | conversion | retention
  budget      Float    @default(0)
  spent       Float    @default(0)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brand       Brand?   @relation(fields: [brandId], references: [id], onDelete: SetNull)
  adsets      AdSet[]
  experiments Experiment[]

  @@index([tenantId])
  @@index([tenantId, channel])
  @@index([tenantId, status])
}

model AdSet {
  id          String   @id @default(cuid())
  campaignId  String
  tenantId    String
  name        String
  audienceId  String?
  bid         Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  ads         Ad[]

  @@index([tenantId])
  @@index([campaignId])
}

model Ad {
  id          String   @id @default(cuid())
  adsetId     String
  creativeId  String?
  tenantId    String
  name        String
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  adset       AdSet    @relation(fields: [adsetId], references: [id], onDelete: Cascade)
  creative    Creative? @relation(fields: [creativeId], references: [id], onDelete: SetNull)
  interactions Interaction[]

  @@index([tenantId])
  @@index([adsetId])
}

// -----------------------------------------------------------------------------
// 5. INTERACTION (analytical — derived from raw events)
// -----------------------------------------------------------------------------

model Interaction {
  id          String   @id @default(cuid())
  tenantId    String
  customerId  String?
  adId        String?
  type        String   // impression | click | view | visit | lead | purchase | revenue
  value       Float    @default(0)
  occurredAt  DateTime
  source      String?
  lineageId   String?
  createdAt   DateTime @default(now())
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  ad          Ad?      @relation(fields: [adId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, type])
  @@index([tenantId, occurredAt])
}

// -----------------------------------------------------------------------------
// 6. CONNECTOR FRAMEWORK (Section 9)
// -----------------------------------------------------------------------------

model Connector {
  id           String   @id @default(cuid())
  tenantId     String
  type         String   // google_ads | shopify | meta | ga4 | salesforce | ...
  name         String
  status       String   @default("connected") // connected | syncing | error | disconnected
  lastSyncAt   DateTime?
  lastSyncStatus String?  // ok | partial | failed
  lastError    String?
  recordsPulled Int     @default(0)
  config       String   // JSON (no secrets — secrets live in SecretRef)
  secretRefId  String?  // reference to SecretRef
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rawRecords   RawRecord[]

  @@index([tenantId])
  @@index([tenantId, type])
}

model SecretRef {
  // Section 24: Credentials must NEVER live in ordinary business tables.
  id        String   @id @default(cuid())
  label     String
  // In production this would reference a vault entry. Here we store an
  // opaque pointer only — the actual secret is held in the environment.
  vaultKey  String
  createdAt DateTime @default(now())
}

// -----------------------------------------------------------------------------
// 7. RAW RECORDS + EVENTS + LINEAGE (Sections 8, 10)
// -----------------------------------------------------------------------------

model RawRecord {
  // Preserves the RAW source verbatim (Section 10: never destroy raw source records).
  id             String   @id @default(cuid())
  tenantId       String
  connectorId    String
  source         String
  sourceRecordId String
  entityType     String   // campaign | ad | customer | order | interaction | ...
  payload        String   // JSON: verbatim source record
  schemaVersion  Int      @default(1)
  dataQuality    String   @default("pending") // pending | valid | invalid
  ingestedAt     DateTime @default(now())
  occurredAt     DateTime?
  lineageId      String   @default(cuid())
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connector      Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@unique([connectorId, sourceRecordId])
  @@index([tenantId])
  @@index([tenantId, entityType])
  @@index([lineageId])
}

model Event {
  // Section 8 — durable, replayable, versioned, idempotent events.
  id           String   @id @default(cuid())
  eventId      String   @unique // idempotency key (tenant + source + sequence)
  tenantId     String
  eventType    String   // customer_created | impression_created | experiment_completed | ...
  entityType   String?
  entityId     String?
  source       String
  occurredAt   DateTime
  ingestedAt   DateTime @default(now())
  schemaVersion Int     @default(1)
  payload      String   // JSON
  lineageId    String?
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, eventType])
  @@index([tenantId, occurredAt])
  @@index([lineageId])
}

// -----------------------------------------------------------------------------
// 8. EVIDENCE GRAPH (Section 11)
// -----------------------------------------------------------------------------

model Edge {
  // Generic graph edge — models the Evidence Graph (and customer/market graphs).
  id           String   @id @default(cuid())
  tenantId     String
  sourceType   String   // Recommendation | Experiment | Observation | ...
  sourceId     String
  relation     String   // based_on | supported_by | informed_by | caused | measured_by | ...
  targetType   String
  targetId     String
  weight       Float    @default(1)
  createdAt    DateTime @default(now())
  metadata     String?  // JSON
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sourceType, sourceId, relation, targetType, targetId])
  @@index([tenantId])
  @@index([tenantId, sourceType, sourceId])
  @@index([tenantId, targetType, targetId])
}

// -----------------------------------------------------------------------------
// 9. EXPERIMENT SERVICE (Section 13)
// -----------------------------------------------------------------------------

model Experiment {
  id              String   @id @default(cuid())
  tenantId        String
  campaignId      String?
  name            String
  hypothesis      String
  objective       String
  population      String?  // JSON
  primaryMetric   String
  secondaryMetrics String? // JSON csv
  guardrailMetrics String? // JSON csv
  methodology     String   @default("ab_test") // ab_test | holdout | geo | uplift
  status          String   @default("draft") // draft | running | completed | analyzed
  sampleSize      Int      @default(0)
  durationDays    Int      @default(14)
  startDate       DateTime?
  endDate         DateTime?
  decision        String?  // ship | iterate | kill
  learning        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign        Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  causalEstimates CausalEstimate[]

  @@index([tenantId])
  @@index([tenantId, status])
}

// -----------------------------------------------------------------------------
// 10. CAUSAL INTELLIGENCE (Section 12)
// -----------------------------------------------------------------------------

model CausalEstimate {
  id              String   @id @default(cuid())
  tenantId        String
  experimentId    String?
  campaignId      String?
  metric          String   // revenue | conversions | roas | ...
  treatment       String
  control         String
  methodology     String   // ab_test | holdout | geo_experiment | mmm | uplift | did
  effectSize      Float    // incremental lift (absolute)
  effectSizePct   Float    // incremental lift (%)
  uncertaintyLow  Float
  uncertaintyHigh Float
  confidence      Float    @default(0.5) // 0..1
  population      String?
  observationWindowDays Int @default(14)
  assumptions     String?  // JSON
  modelVersion    String
  sourceData      String?  // JSON references
  createdAt       DateTime @default(now())
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  experiment      Experiment? @relation(fields: [experimentId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, methodology])
}

// -----------------------------------------------------------------------------
// 11. DECISION ENGINE + LEDGER (Sections 15, 23)
// -----------------------------------------------------------------------------

model Recommendation {
  id                       String   @id @default(cuid())
  tenantId                 String
  opportunity              String
  recommendation           String
  expectedIncrementalProfit Float  @default(0)
  expectedIncrementalRevenue Float @default(0)
  confidence               Float   @default(0.5)
  uncertainty              String? // JSON {low, high}
  risks                    String? // JSON []
  constraints              String? // JSON []
  nextBestExperiment       String?
  status                   String  @default("proposed") // proposed | approved | rejected | executed | learned
  generatedBy              String  @default("decision_engine")
  // AI versioning (Section 26 + hardening pass) — full provenance for every AI-generated recommendation
  aiProvider               String? // zai | openai | anthropic | gemini | local
  aiModel                  String? // glm-4.6 | gpt-4o | claude-3-5-sonnet | ...
  aiModelVersion           String? // model version string
  aiPromptVersion          String? // v1, v2, ...
  aiToolSchemaVersion      String? // tool schema version
  aiAgentVersion           String? // agent version string
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  tenant                   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  decision                 Decision? @relation("DecisionRecommendation")

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([aiProvider, aiModel])
}

model Decision {
  // Section 23 — immutable Decision Ledger
  id              String   @id @default(cuid())
  tenantId        String
  recommendationId String? @unique
  objective       String
  recommendation  String
  evidence        String   // JSON []
  modelsUsed      String?  // JSON []
  assumptions     String?  // JSON []
  expectedOutcome String?  // JSON
  confidence      Float    @default(0.5)
  approverId      String?
  actionTaken     String?
  actualOutcome   String?  // JSON, filled after execution
  learning        String?
  status          String   @default("recorded") // recorded | executed | measured | learned
  executionMode   String?  // SIMULATION | SANDBOX | LIVE (ADR-0005) — mode in which the action was/will be executed
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recommendationRef Recommendation? @relation("DecisionRecommendation", fields: [recommendationId], references: [id], onDelete: SetNull)
  approvals       Approval[]

  @@index([tenantId])
  @@index([tenantId, status])
}

model Approval {
  id          String   @id @default(cuid())
  tenantId    String
  decisionId  String
  approverId  String?
  approverEmail String
  decision    String   // approved | rejected | changes_requested
  note        String?
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  decisionRef Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [approverId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([decisionId])
}

// -----------------------------------------------------------------------------
// 12. WORKFLOW ORCHESTRATION (Section 21)
// -----------------------------------------------------------------------------

model Workflow {
  id          String   @id @default(cuid())
  tenantId    String
  type        String   // research_to_launch | ingestion | experiment_run | ...
  status      String   @default("pending") // pending | running | completed | failed | paused
  input       String?  // JSON
  output      String?  // JSON
  steps       WorkflowStep[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, status])
}

model WorkflowStep {
  id          String   @id @default(cuid())
  workflowId  String
  name        String
  status      String   @default("pending") // pending | running | completed | failed | skipped
  attempt     Int      @default(0)
  startedAt   DateTime?
  finishedAt  DateTime?
  output      String?  // JSON
  error       String?
  workflow    Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
}

// -----------------------------------------------------------------------------
// 13. AGENT RUNS + TOOL CALLS (Sections 18, 24, 25, 26)
// -----------------------------------------------------------------------------

model AgentRun {
  id          String   @id @default(cuid())
  tenantId    String
  agentName   String   // strategy | research | measurement | opportunity | ...
  prompt      String
  output      String?  // JSON
  modelProvider String @default("z-ai")
  modelName   String   @default("glm-4.6")
  promptVersion String @default("v1")
  inputTokens Int      @default(0)
  outputTokens Int     @default(0)
  latencyMs   Int      @default(0)
  status      String   @default("running") // running | completed | failed
  error       String?
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  toolCalls   AgentToolCall[]

  @@index([tenantId])
  @@index([tenantId, agentName])
}

model AgentToolCall {
  id          String   @id @default(cuid())
  tenantId    String
  agentRunId  String
  toolName    String   // get_market_state | get_evidence | query_experiments | ...
  input       String   // JSON
  output      String?  // JSON
  authorized  Boolean  @default(true)
  durationMs  Int      @default(0)
  createdAt   DateTime @default(now())
  agentRun    AgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([agentRunId])
}

// -----------------------------------------------------------------------------
// 14. AUDIT LOG (Section 24 — immutable audit logs)
// -----------------------------------------------------------------------------

model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String
  actorType   String   // user | agent | system
  actorId     String?
  action      String
  entityType  String?
  entityId    String?
  detail      String?  // JSON
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, action])
  @@index([tenantId, createdAt])
}
